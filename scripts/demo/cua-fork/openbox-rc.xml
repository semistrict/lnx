<?xml version="1.0" encoding="UTF-8"?>
<!-- Every window fills the screen without decorations, so recordings show
     only the app. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>yes</maximized>
    </application>
  </applications>
</openbox_config>
