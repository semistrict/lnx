--- a/net/vmw_vsock/virtio_transport.c
+++ b/net/vmw_vsock/virtio_transport.c
@@ -23,6 +23,32 @@ static struct workqueue_struct *virtio_vsock_workqueue;
 static struct virtio_vsock __rcu *the_virtio_vsock;
 static DEFINE_MUTEX(the_virtio_vsock_mutex); /* protects the_virtio_vsock */
 static struct virtio_transport virtio_transport; /* forward declaration */
+
+static atomic_t lnx_vsock_debug_budget = ATOMIC_INIT(256);
+
+static bool lnx_vsock_debug_take(void)
+{
+	int old;
+
+	do {
+		old = atomic_read(&lnx_vsock_debug_budget);
+		if (old <= 0)
+			return false;
+	} while (atomic_cmpxchg(&lnx_vsock_debug_budget, old, old - 1) != old);
+
+	return true;
+}
+
+#define lnx_vsock_debug(fmt, ...)					\
+	do {								\
+		if (lnx_vsock_debug_take())				\
+			pr_err("lnx-vsock-debug " fmt, ##__VA_ARGS__);	\
+	} while (0)
+
+static u32 lnx_vsock_event_id(const struct virtio_vsock_event *event, unsigned int len)
+{
+	return len >= sizeof(*event) ? le32_to_cpu(event->id) : 0xffffffff;
+}
 
