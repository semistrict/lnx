--- a/drivers/irqchip/irq-gic-v3.c
+++ b/drivers/irqchip/irq-gic-v3.c
@@ -6,6 +6,7 @@
 
 #define pr_fmt(fmt)	"GICv3: " fmt
 
+#include <linux/atomic.h>
 #include <linux/acpi.h>
 #include <linux/cpu.h>
 #include <linux/cpu_pm.h>
@@ -862,18 +863,57 @@ static bool gic_irqnr_is_special(u32 irqnr)
 static bool gic_irqnr_is_special(u32 irqnr)
 {
 	return irqnr >= 1020 && irqnr <= 1023;
+}
+
+static atomic_t lnx_gic_debug_budget = ATOMIC_INIT(256);
+
+static bool lnx_gic_debug_take(void)
+{
+	int old;
+
+	do {
+		old = atomic_read(&lnx_gic_debug_budget);
+		if (old <= 0)
+			return false;
+	} while (atomic_cmpxchg(&lnx_gic_debug_budget, old, old - 1) != old);
+
+	return true;
+}
+
+static void lnx_gic_debug_irq(const char *stage, u32 irqnr,
+			      struct pt_regs *regs, bool is_nmi)
+{
+	if (!lnx_gic_debug_take())
+		return;
+
+	pr_err("lnx-debug %s cpu=%u irqnr=%u special=%u nmi=%u pc=0x%llx pstate=0x%llx pmr=0x%llx rpr=0x%llx ctlr=0x%llx igrpen0=0x%llx igrpen1=0x%llx\n",
+	       stage, raw_smp_processor_id(), irqnr,
+	       gic_irqnr_is_special(irqnr), is_nmi,
+	       (unsigned long long)regs->pc,
+	       (unsigned long long)regs->pstate,
+	       (unsigned long long)gic_read_pmr(),
+	       (unsigned long long)gic_read_rpr(),
+	       (unsigned long long)gic_read_ctlr(),
+	       (unsigned long long)read_gicreg(ICC_IGRPEN0_EL1),
+	       (unsigned long long)read_gicreg(ICC_IGRPEN1_EL1));
 }
 
 static void __gic_handle_irq(u32 irqnr, struct pt_regs *regs)
 {
+	lnx_gic_debug_irq("handle_irq.enter", irqnr, regs, false);
+
 	if (gic_irqnr_is_special(irqnr))
 		return;
 
 	gic_complete_ack(irqnr);
+	lnx_gic_debug_irq("handle_irq.acked", irqnr, regs, false);
 
 	if (generic_handle_domain_irq(gic_data.domain, irqnr)) {
+		lnx_gic_debug_irq("handle_irq.unexpected", irqnr, regs, false);
 		WARN_ONCE(true, "Unexpected interrupt (irqnr %u)\n", irqnr);
 		gic_deactivate_unhandled(irqnr);
+	} else {
+		lnx_gic_debug_irq("handle_irq.done", irqnr, regs, false);
 	}
 }
 
@@ -909,6 +949,7 @@ static void __gic_handle_irq_from_irqson(struct pt_regs *regs)
 	irqnr = gic_read_iar();
 
 	is_nmi = gic_rpr_is_nmi_prio();
+	lnx_gic_debug_irq("from_irqson.iar", irqnr, regs, is_nmi);
 
 	if (is_nmi) {
 		nmi_enter();
@@ -957,6 +998,7 @@ static void __gic_handle_irq_from_irqsoff(struct pt_regs *regs)
 	isb();
 	irqnr = gic_read_iar();
 	gic_write_pmr(pmr);
+	lnx_gic_debug_irq("from_irqsoff.iar", irqnr, regs, true);
 
 	__gic_handle_nmi(irqnr, regs);
 }
