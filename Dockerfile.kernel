FROM ubuntu:26.04 AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    bc \
    bison \
    flex \
    dwarves \
    libelf-dev \
    libssl-dev \
    ca-certificates \
    curl \
    cpio \
    xz-utils \
    patch \
    && rm -rf /var/lib/apt/lists/*

ARG LINUX_VERSION=7.1.2
# Fresh point releases can lag on the CDN, so fall back to the (slower)
# cgit snapshot of the stable tag.
RUN mkdir /build && \
    { curl -fL "https://cdn.kernel.org/pub/linux/kernel/v${LINUX_VERSION%%.*}.x/linux-${LINUX_VERSION}.tar.xz" | \
      tar -xJ -C /build --strip-components=1 || \
      { rm -rf /build/* && \
        curl -fL "https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git/snapshot/linux-${LINUX_VERSION}.tar.gz" | \
        tar -xz -C /build --strip-components=1; }; }

WORKDIR /build

COPY kernel-patches /kernel-patches
RUN for patch in /kernel-patches/*.patch; do patch -p1 < "$patch"; done

COPY kernel.config .config
RUN make olddefconfig && make -j$(nproc)

# Artifact-only stage so `--output type=local` exports just the kernel image.
FROM scratch
COPY --from=build /build/arch/arm64/boot/Image /vmlinuz
