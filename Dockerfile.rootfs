FROM ubuntu:26.04 AS rootfs

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git curl wget build-essential ca-certificates openssh-client \
    python3-minimal \
    sudo \
    vim less file strace gdb \
    iproute2 iputils-ping dnsutils net-tools tcpdump \
    procps sysstat iptables nftables isc-dhcp-client \
    systemd systemd-sysv systemd-resolved dbus udev \
    e2fsprogs \
    linux-tools-common \
    podman buildah skopeo uidmap slirp4netns fuse-overlayfs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Latest node + npm from the official nodejs.org tarball, plus pnpm from the
# npm registry. Baked into /usr/local so instances need no package bootstrap.
RUN set -eux; \
    curl -fsSLO https://nodejs.org/dist/latest/SHASUMS256.txt; \
    tarball="$(awk '$2 ~ /^node-v[0-9.]+-linux-arm64\.tar\.gz$/ {print $2}' SHASUMS256.txt)"; \
    test -n "$tarball"; \
    curl -fsSLO "https://nodejs.org/dist/latest/$tarball"; \
    grep " $tarball\$" SHASUMS256.txt | sha256sum -c -; \
    tar -xzf "$tarball" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "$tarball" SHASUMS256.txt; \
    npm install -g pnpm; \
    node --version; npm --version; pnpm --version

FROM ubuntu:26.04 AS image

RUN apt-get update && apt-get install -y --no-install-recommends \
    e2fsprogs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=rootfs / /rootfs

RUN truncate -s 4G /rootfs.ext4 && \
    mke2fs -F -t ext4 -b 16384 -d /rootfs -L lnx /rootfs.ext4

# Artifact-only stage so `--output type=local` exports just the ext4 image.
FROM scratch
COPY --from=image /rootfs.ext4 /rootfs.ext4
