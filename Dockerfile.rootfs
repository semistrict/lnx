FROM ubuntu:26.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    debootstrap e2fsprogs \
    && rm -rf /var/lib/apt/lists/*

# Layer 1: base debootstrap (slow, cached)
RUN debootstrap --arch=arm64 resolute /rootfs http://ports.ubuntu.com/ubuntu-ports

# Layer 2: enable universe
RUN echo 'deb http://ports.ubuntu.com/ubuntu-ports resolute main universe' > /rootfs/etc/apt/sources.list && \
    echo 'deb http://ports.ubuntu.com/ubuntu-ports resolute-updates main universe' >> /rootfs/etc/apt/sources.list

# Layer 3: apt update (separate so package install can change without re-updating)
RUN chroot /rootfs apt-get update

# Layer 4: dev tools
RUN chroot /rootfs apt-get install -y --no-install-recommends \
    git curl wget build-essential ca-certificates openssh-client \
    vim less file strace gdb

# Layer 5: system / network tools
RUN chroot /rootfs apt-get install -y --no-install-recommends \
    iproute2 iputils-ping dnsutils net-tools tcpdump \
    procps sysstat iptables nftables isc-dhcp-client

# Layer 6: perf
RUN chroot /rootfs apt-get install -y --no-install-recommends \
    linux-tools-common

# Layer 7: containers
RUN chroot /rootfs apt-get install -y --no-install-recommends \
    podman buildah skopeo uidmap slirp4netns fuse-overlayfs

# Layer 8: GUI (compositor + terminal for --gui mode)
RUN chroot /rootfs apt-get install -y --no-install-recommends \
    cage foot mesa-utils libgl1-mesa-dri seatd

# Layer 9: cleanup
RUN chroot /rootfs apt-get clean && rm -rf /rootfs/var/lib/apt/lists/*

# Layer 10: build ext4
# Use ^orphan_file,^metadata_csum_seed for kernel 7.0 compat.
RUN truncate -s 16G /rootfs.ext4 && \
    mke2fs -t ext4 -O ^orphan_file,^metadata_csum_seed -d /rootfs -L lnx /rootfs.ext4
